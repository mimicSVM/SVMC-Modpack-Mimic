{
  "nombre": "MimicZ",
  "minecraft": "1.20.1",
  "loader": {
    "tipo": "forge",
    "version": "47.4.0"
  },
  "servidor": "mimicz.playit.plus",
  "ramRecomendadaMB": 8192,
  "mensaje": "Bienvenido al servidor",
  "carpetasEstrictas": [
